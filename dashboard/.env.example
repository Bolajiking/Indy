# Backend API URL (the Hono server)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Privy (must match the root .env PRIVY_APP_ID)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Public support address shown in legal and account-recovery surfaces.
NEXT_PUBLIC_SUPPORT_EMAIL=support@chainfren.com
