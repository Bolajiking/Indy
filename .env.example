# AI provider
# AI_PROVIDER selects the backend for all agent operations.
#   anthropic (default) → Anthropic Messages API
#   openai              → any OpenAI-compatible Chat Completions endpoint
#                         (OpenAI, Azure OpenAI, OpenRouter, LiteLLM, Ollama,
#                          vLLM, LM Studio, OpenClaw gateways, …)
AI_PROVIDER=anthropic
# Optional overrides (leave blank to use provider defaults):
#   AI_BASE_URL   custom endpoint (required for self-hosted / gateways)
#   AI_API_KEY    overrides the provider key below
#   AI_MODEL      default-tier model id (e.g. gpt-4o, claude-sonnet-4-6)
#   AI_FAST_MODEL fast-tier model id (e.g. gpt-4o-mini, claude-haiku-4-5)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FAST_MODEL=

# Provider keys (used when AI_API_KEY is blank)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# Direct or pooler Postgres URL used by one-off schema migrations.
DATABASE_URL=postgresql://postgres.xxx:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=
# Required in production. Dedicated secret for dashboard-issued Telegram/WhatsApp link codes.
MESSAGING_LINK_SECRET=

# Google / YouTube OAuth
# Enable only when the Google credentials and callback below are configured.
ENABLE_YOUTUBE_OAUTH=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Exact Google OAuth callback on the API origin, e.g. http://localhost:3000/api/platforms/oauth/youtube/callback
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/platforms/oauth/youtube/callback
# Dashboard origin used for post-callback redirects back into /dashboard/settings; local default shown here is for dev only
DASHBOARD_APP_URL=http://localhost:3001

# Dashboard (when running/building dashboard directly, also put these in dashboard/.env.local or export them in that shell)
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_API_URL=http://localhost:3000

# Live smoke helpers
# Use a real Privy access token captured from a signed-in dashboard session when running npm run smoke:auth
SMOKE_PRIVY_ACCESS_TOKEN=
# Optional overrides for smoke-auth
SMOKE_API_URL=http://localhost:3000
SMOKE_CHECK_DASHBOARD_PROXY=false
SMOKE_DASHBOARD_URL=http://localhost:3001

# Telegram
# disabled, polling, or webhook. Production requires a token unless disabled.
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
# Optional bot username for dashboard deep links, e.g. indyfren_bot
TELEGRAM_BOT_USERNAME=
# Required in production when TELEGRAM_MODE=webhook. Pass this to Telegram as
# setWebhook's secret_token field; Telegram sends it back in the auth header.
# Generate a unique value with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp
# Enable only when all webhook and Graph API secrets below are configured.
ENABLE_WHATSAPP=false
WHATSAPP_PHONE_NUMBER_ID=
# Optional business number for wa.me links, digits only or E.164
WHATSAPP_BUSINESS_PHONE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Redis is mandatory in production and must point to a managed, non-loopback service.
# The localhost value below is for development/test only.
REDIS_URL=redis://localhost:6379

# Request trust and platform credential encryption
# Number of trusted reverse-proxy hops. Allowed range: 0-2.
TRUSTED_PROXY_HOPS=0
# Active key identifier and key material. Generate unique secret key material; do not reuse app secrets.
PLATFORM_ENCRYPTION_KEY_VERSION=
PLATFORM_ENCRYPTION_KEY_V1=
# Optional previous key material retained only during key rotation.
PLATFORM_ENCRYPTION_KEY_PREVIOUS=

# Operations (optional until a reporting provider/support channel is configured)
ERROR_REPORTING_DSN=
PUBLIC_SUPPORT_EMAIL=

# BrowserBase
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# MCP Servers (optional)
# JSON array of MCPServerConfig objects. Each server's tools are auto-registered at startup.
# Example: [{"name":"stripe","transport":{"type":"stdio","command":"npx","args":["-y","@stripe/mcp"]}}]
MCP_SERVERS=

# x402 Service Discovery (optional)
# URL of the agentcash bazaar or Tempo marketplace for live service discovery.
# Falls back to the static registry when not set.
AGENTCASH_BAZAAR_URL=

# Feature Flags
ENABLE_TELEGRAM_BOT=true
ENABLE_JOBS=true
# Must be true in production. Set false only for local development/test.
ENABLE_DISTRIBUTED_RATE_LIMIT=false

# App
PORT=3000
NODE_ENV=development
