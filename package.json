{
  "name": "indyfren",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "db:migrate:payment-attempts": "tsx scripts/apply-payment-attempts-schema.ts",
    "migrate:platform-secrets": "tsx scripts/migrate-platform-secrets.ts",
    "smoke:preflight": "node --import tsx scripts/preflight.ts",
    "smoke:auth": "node --import tsx scripts/smoke-auth.ts",
    "test:mpp": "tsx scripts/test-mpp.ts",
    "dev:all": "npx concurrently -n api,dash -c blue,magenta \"npm run dev\" \"npm run dashboard:dev\"",
    "dashboard:dev": "npm run dev --prefix dashboard",
    "dashboard:build": "npm run build --prefix dashboard",
    "dashboard:start": "npm run start --prefix dashboard",
    "verify": "npm test && npm run build && npm run dashboard:build && npx prettier --check 'src/**/*.ts' 'tests/**/*.ts' && npm audit --audit-level=moderate && npm audit --audit-level=high --prefix dashboard"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@composio/core": "^0.10.0",
    "@hono/node-server": "^1.19.11",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@privy-io/node": "^0.11.0",
    "@supabase/supabase-js": "^2.99.2",
    "@types/node": "^25.5.0",
    "bullmq": "^5.71.0",
    "dotenv": "^17.3.1",
    "grammy": "^1.41.1",
    "hono": "^4.12.8",
    "mppx": "^0.4.12",
    "pino": "^10.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "viem": "^2.47.5",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.0.1",
    "pg": "^8.21.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
